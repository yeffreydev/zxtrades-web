---
import Layout from '../layouts/Layout.astro';
import ProductArt from '../components/ProductArt.astro';
import TelegramCTA from '../components/TelegramCTA.astro';
import { products } from '../data/products';

// Solo un adelanto visual: sin precios ni carrito hasta el lanzamiento.
const teaser = products.slice(0, 3);
---

<Layout title="Shop — Próximamente | ZXTrades" description="El merch oficial de ZXTrades llega pronto. Únete a Telegram para enterarte del lanzamiento.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">ZX Shop</span>
      <h1>Merch oficial <span class="grad-text">próximamente</span></h1>
      <p>Estamos preparando ropa y accesorios para los que viven el chart. Avisaremos del lanzamiento en la comunidad.</p>
      <div class="sub"><TelegramCTA label="Avísame en Telegram" /></div>
    </div>
  </section>

  <section class="container">
    <div class="grid">
      {teaser.map((p) => (
        <div class="card item">
          <span class="soon">Próximamente</span>
          <div class="art"><ProductArt kind={p.kind} color={p.color} /></div>
          <span class="cat">{p.category}</span>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .sub {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }
  .item {
    position: relative;
    padding: 1.4rem;
    text-align: center;
  }
  .item:hover {
    transform: none;
  }
  .art {
    filter: blur(1.5px) saturate(0.8);
    opacity: 0.75;
  }
  .soon {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: var(--accent);
    color: #1a0d33;
    font-weight: 600;
  }
  .cat {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
