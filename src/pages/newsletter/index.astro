---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';

const issues = (await getCollection('newsletter')).sort((a, b) => b.data.issue - a.data.issue);
const [latest, ...archive] = issues;
const { Content } = await render(latest);
const fmt = (d: Date) => d.toLocaleDateString('es', { timeZone: 'UTC', day: 'numeric', month: 'long', year: 'numeric' });
const num = (n: number) => `#${String(n).padStart(3, '0')}`;
---

<Layout title="Newsletter — ZXTrades" description="ZX Weekly: el mapa del mercado, setup de la semana y lecciones rápidas cada domingo.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">ZX Weekly</span>
      <h1>La newsletter de <span class="grad-text">ZXTrades</span></h1>
      <p>Cada domingo: niveles clave, calendario macro, setup de la semana y una lección rápida.</p>
      <div class="sub" id="suscribirse"><SubscribeForm /></div>
    </div>
  </section>

  <section class="container layout">
    <article class="issue card">
      <div class="issue-bar">
        <span class="tag">Última edición</span>
        <span class="mono">{num(latest.data.issue)} · {fmt(latest.data.pubDate)}</span>
      </div>
      <h2>{latest.data.title}</h2>
      <div class="prose">
        <Content />
      </div>
    </article>

    <aside class="archive">
      <h3>Archivo</h3>
      <ul>
        {archive.map((i) => (
          <li>
            <a href={`/newsletter/${i.id}`}>
              <span class="mono">{num(i.data.issue)}</span>
              <b>{i.data.title}</b>
              <small>{i.data.summary}</small>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </section>
</Layout>

<style>
  .sub {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  .layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2rem;
    align-items: start;
  }
  .issue {
    padding: 2.5rem;
  }
  .issue:hover {
    transform: none;
  }
  .issue-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-bottom: 1.2rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .issue h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }
  .issue .prose {
    max-width: none;
  }
  .mono {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .archive {
    position: sticky;
    top: 6rem;
  }
  .archive h3 {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .archive ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .archive a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    transition: border-color 0.2s;
  }
  .archive a:hover {
    border-color: var(--green);
  }
  .archive small {
    color: var(--muted);
    font-size: 0.85rem;
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .archive {
      position: static;
    }
    .issue {
      padding: 1.5rem;
    }
  }
</style>
