---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TelegramCTA from '../../components/TelegramCTA.astro';
import { fmtDate, getPosts, readingTime } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts(); // más reciente primero
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, summary, pubDate, tags } = post.data;
---

<Layout title={`${title} — Blog ZXTrades`} description={summary}>
  <article>
    <header class="page-hero">
      <div class="container">
        <a href="/blog" class="back">← Todos los posts</a>
        <div class="meta">
          <time datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time>
          <span>·</span>
          <span class="mono">{readingTime(post.body)} min de lectura</span>
        </div>
        <h1>{title}</h1>
        <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
      </div>
    </header>

    <div class="container prose">
      <Content />
    </div>

    <nav class="container pager">
      {older ? <a href={`/blog/${older.id}`}>← {older.data.title}</a> : <span></span>}
      {newer && <a href={`/blog/${newer.id}`} class="right">{newer.data.title} →</a>}
    </nav>

    <section class="container">
      <div class="card cta">
        <div>
          <h3>Sigue la conversación</h3>
          <p>Análisis y alertas del día en nuestra comunidad gratuita de Telegram.</p>
        </div>
        <TelegramCTA />
      </div>
    </section>
  </article>
</Layout>

<style>
  .back {
    display: inline-block;
    color: var(--muted);
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }
  .meta {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  .mono {
    font-family: var(--font-mono);
  }
  .tags {
    display: flex;
    gap: 0.4rem;
    justify-content: center;
  }
  h1 {
    max-width: 20ch;
    margin-inline: auto;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    max-width: 72ch;
    margin: 4rem auto 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    font-size: 0.95rem;
  }
  .pager a {
    color: var(--muted);
  }
  .pager a:hover {
    color: var(--brand);
  }
  .right {
    text-align: right;
  }
  .cta {
    max-width: 72ch;
    margin: 0 auto;
    padding: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .cta:hover {
    transform: none;
  }
  .cta h3 {
    margin: 0 0 0.3rem;
  }
  .cta p {
    margin: 0;
    color: var(--muted);
  }
</style>
