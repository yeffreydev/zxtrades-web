---
import Logo from './Logo.astro';
import { TELEGRAM_URL } from '../data/site';

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/blog', label: 'Blog' },
  { href: '/recursos', label: 'Recursos' },
  { href: '/shop', label: 'Shop', badge: 'Pronto' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="header" id="site-header">
  <div class="container inner">
    <a href="/" aria-label="ZXTrades inicio"><Logo /></a>

    <nav class="nav" id="nav">
      {links.map((l) => (
        <a href={l.href} class:list={[{ active: isActive(l.href) }]}>
          {l.label}
          {l.badge && <span class="badge">{l.badge}</span>}
        </a>
      ))}
      <a href={TELEGRAM_URL} target="_blank" rel="noopener" class="nav-tg">Comunidad gratis en Telegram →</a>
    </nav>

    <div class="actions">
      <a href={TELEGRAM_URL} target="_blank" rel="noopener" class="btn btn-primary join">Únete gratis</a>
      <button class="burger" id="burger" aria-label="Menú" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 1rem 0;
    transition:
      background 0.3s,
      padding 0.3s,
      border-color 0.3s;
    border-bottom: 1px solid transparent;
  }
  .header.scrolled {
    background: rgba(7, 5, 13, 0.75);
    backdrop-filter: blur(14px);
    border-color: var(--border);
    padding: 0.6rem 0;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .nav {
    display: flex;
    gap: 0.25rem;
    padding: 0.35rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(18, 14, 30, 0.6);
    backdrop-filter: blur(10px);
  }
  .nav a {
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-size: 0.92rem;
    color: var(--muted);
    transition:
      color 0.2s,
      background 0.2s;
  }
  .nav a:hover {
    color: var(--text);
  }
  .nav a.active {
    background: var(--surface-2);
    color: var(--text);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .badge {
    margin-left: 0.35rem;
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    font-size: 0.65rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    background: rgba(139, 61, 255, 0.18);
    color: var(--accent);
  }
  .nav-tg {
    display: none;
  }
  .join {
    padding: 0.6rem 1.1rem;
  }
  .burger {
    display: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: transparent;
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }
  .burger span {
    width: 16px;
    height: 2px;
    background: var(--text);
    transition: transform 0.25s;
  }
  .burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (max-width: 820px) {
    .burger {
      display: flex;
    }
    .join {
      display: none;
    }
    .nav {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 1rem;
      right: 1rem;
      flex-direction: column;
      border-radius: var(--radius);
      background: var(--surface);
      padding: 0.6rem;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
      transition:
        opacity 0.2s,
        transform 0.2s;
    }
    .nav.open {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
    .nav a {
      padding: 0.8rem 1rem;
    }
    .nav .nav-tg {
      display: block;
      color: var(--brand);
      font-weight: 600;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 20);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const burger = document.getElementById('burger')!;
  const nav = document.getElementById('nav')!;
  burger.addEventListener('click', () => {
    const open = nav.classList.toggle('open');
    burger.setAttribute('aria-expanded', String(open));
  });

</script>
