---
import { TELEGRAM_URL } from '../data/site';

interface Props {
  label?: string;
  size?: 'md' | 'lg';
}
const { label = 'Únete gratis en Telegram', size = 'md' } = Astro.props;
---

<a href={TELEGRAM_URL} target="_blank" rel="noopener" class:list={['btn', 'btn-primary', 'tg', size]}>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M21.94 4.3a1 1 0 0 0-1.36-.94L2.9 10.4a1 1 0 0 0 .07 1.88l4.37 1.36 1.66 5.3a1 1 0 0 0 1.66.42l2.45-2.35 4.32 3.17a1 1 0 0 0 1.57-.6l2.94-14.27zM9.9 14.6l-.48 3.02-1.2-3.82 9.3-6.16-7.62 6.96z" />
  </svg>
  {label}
</a>

<style>
  .tg {
    gap: 0.55rem;
  }
  .lg {
    padding: 1rem 1.7rem;
    font-size: 1.05rem;
  }
</style>
