---
import type { Product } from '../data/products';
import ProductArt from './ProductArt.astro';

interface Props {
  product: Product;
}
const { product } = Astro.props;
---

<article class="card product" data-category={product.category}>
  <div class="media">
    {product.badge && <span class="badge">{product.badge}</span>}
    <ProductArt kind={product.kind} color={product.color} />
  </div>
  <div class="body">
    <span class="cat">{product.category}</span>
    <h3>{product.name}</h3>
    <p>{product.description}</p>
    <div class="foot">
      <span class="price">${product.price}</span>
      <button
        class="btn btn-primary add"
        data-add-to-cart
        data-id={product.id}
        data-name={product.name}
        data-price={product.price}
      >
        Agregar
      </button>
    </div>
  </div>
</article>

<style>
  .product {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .media {
    position: relative;
    aspect-ratio: 1 / 0.85;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 60%, rgba(139, 61, 255, 0.14), transparent 60%),
      var(--bg-2);
    border-bottom: 1px solid var(--border);
  }
  .product:hover :global(.art) {
    transform: scale(1.06) rotate(-2deg);
  }
  .badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: var(--lime);
    color: #1a0d33;
    font-weight: 600;
  }
  .body {
    padding: 1.25rem 1.4rem 1.4rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .cat {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  h3 {
    font-size: 1.2rem;
    margin: 0.35rem 0 0.4rem;
  }
  p {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 1.25rem;
    flex: 1;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .price {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    font-weight: 600;
  }
  .add {
    padding: 0.6rem 1.1rem;
    font-size: 0.85rem;
  }
  .add.added {
    background: var(--surface-2);
    color: var(--brand);
    box-shadow: none;
  }
</style>
