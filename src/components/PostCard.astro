---
import type { CollectionEntry } from 'astro:content';
import { fmtDate, readingTime } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, summary, pubDate, tags } = post.data;
---

<a href={`/blog/${post.id}`} class="card post">
  <div class="meta">
    <time datetime={pubDate.toISOString()}>{fmtDate(pubDate, 'short')}</time>
    <span>·</span>
    <span>{readingTime(post.body)} min</span>
  </div>
  <h3>{title}</h3>
  <p>{summary}</p>
  <div class="foot">
    <div class="tags">{tags.slice(0, 2).map((t) => <span class="tag">{t}</span>)}</div>
    <span class="read">Leer →</span>
  </div>
</a>

<style>
  .post {
    display: flex;
    flex-direction: column;
    padding: 1.6rem;
    height: 100%;
  }
  .meta {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 0.8rem;
  }
  h3 {
    font-size: 1.3rem;
  }
  p {
    color: var(--muted);
    margin: 0 0 1.4rem;
    font-size: 0.95rem;
  }
  .foot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .read {
    color: var(--brand);
    font-weight: 600;
    white-space: nowrap;
  }
</style>
