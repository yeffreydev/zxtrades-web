---
const items = [
  ['BTC/USD', '+2.41%'],
  ['ETH/USD', '+1.87%'],
  ['SPX', '+0.62%'],
  ['NAS100', '+0.94%'],
  ['EUR/USD', '-0.18%'],
  ['XAU/USD', '+0.73%'],
  ['GBP/JPY', '-0.32%'],
  ['SOL/USD', '+4.10%'],
  ['US30', '+0.41%'],
  ['USD/JPY', '+0.22%'],
];
---

<div class="ticker" aria-hidden="true">
  <div class="track">
    {[...items, ...items].map(([sym, chg]) => (
      <span class="item">
        <b>{sym}</b>
        <span class:list={[chg.startsWith('-') ? 'down' : 'up']}>
          {chg.startsWith('-') ? '▼' : '▲'} {chg}
        </span>
      </span>
    ))}
  </div>
</div>

<style>
  .ticker {
    border-block: 1px solid var(--border);
    background: rgba(18, 14, 30, 0.5);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    animation: scroll 40s linear infinite;
  }
  .item {
    display: inline-flex;
    gap: 0.6rem;
    padding: 0.9rem 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .item b {
    color: var(--text);
    font-weight: 600;
  }
  .up {
    color: var(--green);
  }
  .down {
    color: var(--red);
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
</style>
