---
interface Props {
  size?: number;
  wordmark?: boolean;
}
const { size = 36, wordmark = true } = Astro.props;
const id = `zx-${Math.random().toString(36).slice(2, 8)}`;
---

<span class="logo">
  <svg width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id={id} x1="0" y1="64" x2="64" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#00E58F" />
        <stop offset="1" stop-color="#C6FF3D" />
      </linearGradient>
    </defs>
    <rect width="64" height="64" rx="16" fill="#0A0F0D" />
    <rect x="1" y="1" width="62" height="62" rx="15" stroke={`url(#${id})`} stroke-opacity=".35" stroke-width="2" />
    <path d="M12 18h20l-16 28h16" stroke={`url(#${id})`} stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M38 46l14-28" stroke={`url(#${id})`} stroke-width="5" stroke-linecap="round" />
    <path d="M44 18h8v8" stroke={`url(#${id})`} stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M38 18l5 10M47 36l5 10" stroke="#00E58F" stroke-opacity=".55" stroke-width="5" stroke-linecap="round" />
  </svg>
  {wordmark && (
    <span class="wordmark">
      ZX<span>TRADES</span>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.02em;
    color: var(--text);
  }
  .wordmark span {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
