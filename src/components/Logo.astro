---
interface Props {
  size?: number;
  wordmark?: boolean;
}
const { size = 36, wordmark = true } = Astro.props;
---

<span class="logo">
  <img src="/logo.png" width={size} height={size} alt={wordmark ? '' : 'ZXTrades'} decoding="async" />
  {wordmark && (
    <span class="wordmark">
      Z<span class="x">X</span><span class="rest">TRADES</span>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .logo img {
    border-radius: 22%;
    box-shadow: 0 0 18px -4px rgba(139, 61, 255, 0.55);
  }
  /* Igual que la app: itálica, Z blanca, X violeta. */
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-style: italic;
    font-size: 1.25rem;
    letter-spacing: 0.02em;
    color: var(--text);
  }
  .x {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.08em;
  }
  .rest {
    margin-left: 0.1em;
  }
</style>
